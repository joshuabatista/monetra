RewriteRule ^get-saldos-ano$ /src/modulos/publico/backend/publico-get-saldos-ano.php [L] 
RewriteRule ^get-porcentagem$ /src/modulos/publico/backend/publico-get-porcentagem-mensal.php [L] 
RewriteRule ^save-minucioso$ /src/modulos/publico/backend/publico-salvar-minucioso.php [L] 
RewriteRule ^get-minucioso$ /src/modulos/publico/backend/publico-get-minucioso.php [L] 
RewriteRule ^get-pagar-receber$ /src/modulos/publico/backend/publico-get-pagar-receber.php [L] 
