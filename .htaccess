RewriteRule ^save-movimentation$ /src/modulos/publico/backend/publico-salvar-movimentacao.php [L] 
RewriteRule ^get-plano$ /src/modulos/publico/backend/publico-get-plano-contas.php [L] 
RewriteRule ^get-plano-card$ /src/modulos/publico/backend/publico-get-plano-contas-cartao.php [L] 
